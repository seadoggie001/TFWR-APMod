<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net462</TargetFramework>
        <RootNamespace>com.seadoggie.TFWRArchipelago</RootNamespace>
        <AssemblyName>TFWRArchipelago</AssemblyName>
        <Description>Archipelago implementation</Description>
        <Version>0.0.11</Version>
        <LangVersion>latest</LangVersion>
        <RestoreAdditionalProjectSources>
            https://api.nuget.org/v3/index.json;
            https://nuget.bepinex.dev/v3/index.json;
        </RestoreAdditionalProjectSources>
        <IsPackable>false</IsPackable>
        <Authors>seadoggie</Authors>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <!-- Import a settings file. See local.props.txt for more information -->
    <Import Project="local.props" Condition="Exists('local.props')" />

    <ItemGroup>
        <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
        <PackageReference Include="Archipelago.MultiClient.Net" Version="6.7.1" />
        <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
        <PackageReference Include="BepInEx.Core" Version="5.*" PrivateAssets="all" />
        <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" PrivateAssets="all" />
        <PackageReference Include="DroneLib" Version="0.0.3" />
        <PackageReference Include="UnityEngine.Modules" Version="2021.3.5" PrivateAssets="all"  />

        <Reference Include="$(ManagedPath)/Core.dll" Publicize="true"/>
        <Reference Include="$(ManagedPath)/Utils.dll" Publicize="true"/>
        <Reference Include="$(ManagedPath)/Assembly-CSharp.dll" Publicize="true"/>
        <Reference Include="$(ManagedPath)/NewAssembly.dll" Publicize="true"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Assets\archipelago">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </EmbeddedResource>
        <EmbeddedResource Include="Assets\archipelago.manifest">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </EmbeddedResource>
        <EmbeddedResource Include="Assets\StandaloneWindows64">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </EmbeddedResource>
        <EmbeddedResource Include="Assets\StandaloneWindows64.manifest">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <None Update="data.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    
    <Target Name="EmptyPublishFolder" BeforeTargets="PrepareForPublish">
        <Message Text="Emptying target folder: $(PublishDir)" Importance="high" />
        <RemoveDir Directories="$(PublishDir)" />
        <MakeDir Directories="$(PublishDir)" />
    </Target>

    <Target Name="ZipPublishOutput" AfterTargets="Publish">
        <Message Text="Zipping publish output..." Importance="high" />

        <ZipDirectory
                SourceDirectory="$(PublishDir)"
                DestinationFile="$(MSBuildProjectDirectory)\bin\$(Configuration)\TFWRArchipelago.zip"
                Overwrite="true" />
    </Target>
</Project>
